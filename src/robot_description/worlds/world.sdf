<?xml version="1.0"?>
<sdf version="1.9">
  <world name="mobile_manipulation_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>

    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.3 0.4 0.5 1.0</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- ===================== GROUND PLANE ===================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== OUTER WALLS ===================== -->
    <model name="wall_south">
      <static>true</static><pose>0 -4 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.1 0.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.1 0.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south_left_wing">
      <static>true</static><pose>-4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.1 0.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.1 0.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south_right_wing">
      <static>true</static><pose>4 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.1 0.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.1 0.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west_upper">
      <static>true</static><pose>-6 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east_upper">
      <static>true</static><pose>6 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west_lower">
      <static>true</static><pose>-2 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east_lower">
      <static>true</static><pose>2 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west_top">
      <static>true</static><pose>-2 6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east_top">
      <static>true</static><pose>2 6 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.1 4.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.1 4.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_north_top">
      <static>true</static><pose>0 8 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.1 0.1 2.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.1 0.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== INNER WALLS & DOORWAYS ===================== -->
    <model name="wall_north_left_wing">
      <static>true</static><pose>-4 4 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>4.1 0.1 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.1 0.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual></link>
    </model>

    <model name="wall_north_right_wing">
      <static>true</static><pose>4 4 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>4.1 0.1 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.1 0.1 2.5</size></box></geometry><material><ambient>0.85 0.88 0.9 1</ambient><diffuse>0.85 0.88 0.9 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_north_left">
      <static>true</static><pose>-1.3 4 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.1 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_north_right">
      <static>true</static><pose>1.3 4 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.1 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_left_bottom">
      <static>true</static><pose>-2 0.7 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 1.4 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.4 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_left_top">
      <static>true</static><pose>-2 3.3 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 1.4 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.4 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_right_bottom">
      <static>true</static><pose>2 0.7 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 1.4 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.4 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_right_top">
      <static>true</static><pose>2 3.3 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.1 1.4 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.1 1.4 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_center_left">
      <static>true</static><pose>-1.3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.1 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <model name="wall_door_center_right">
      <static>true</static><pose>1.3 0 1.25 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>1.4 0.1 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.1 2.5</size></box></geometry><material><ambient>0.75 0.8 0.85 1</ambient><diffuse>0.75 0.8 0.85 1</diffuse></material></visual></link>
    </model>

    <!-- ===================== ASYMMETRIC FURNITURE ===================== -->
    
    <!-- Fourth Room Drop-off Table -->
    <model name="table_top_dropoff">
      <static>true</static>
      <pose>0 6 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.6 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.2 0.6 0.3</size></box></geometry><material><ambient>0.8 0.8 0.85 1</ambient><diffuse>0.8 0.8 0.85 1</diffuse></material></visual>
      </link>
    </model>

    <!-- NEW: Fourth Room Tall Cabinet (Breaks Symmetry) -->
    <model name="cabinet_top_room">
      <static>true</static>
      <pose>1.4 7.4 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.6 0.6 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.6 0.6 2.0</size></box></geometry><material><ambient>0.3 0.5 0.7 1</ambient><diffuse>0.3 0.5 0.7 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Left Room: Shallow Rectangular Table -->
    <model name="table_left">
      <static>true</static>
      <pose>-4 2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.0 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 1.0 0.3</size></box></geometry><material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Right Room: Smaller Cylindrical Table -->
    <model name="table_right_cylinder">
      <static>true</static>
      <pose>4 2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.3</radius><length>0.3</length></cylinder></geometry><material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Bottom Room: Shallow Table -->
    <model name="table_bottom">
      <static>true</static>
      <pose>0 -2 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.4 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.0 0.4 0.3</size></box></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Bottom Room Bookshelf Obstacle -->
    <model name="bookshelf_bottom">
      <static>true</static>
      <pose>-1.5 -3 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 1.2 2.0</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 1.2 2.0</size></box></geometry><material><ambient>0.4 0.2 0.1 1</ambient><diffuse>0.4 0.2 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ===================== DYNAMIC PICK AND PLACE TARGETS ===================== -->
    
    <!-- Target 1: 4cm Red Cube -->
    <model name="target_red_cube">
      <static>false</static>
      <pose>-4 2 0.32 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><box><size>0.04 0.04 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.04 0.04 0.04</size></box></geometry><material><ambient>0.9 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Target 2: 4cm Diameter Blue Cylinder -->
    <model name="target_blue_cylinder">
      <static>false</static>
      <pose>4 2 0.33 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><cylinder><radius>0.02</radius><length>0.06</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.02</radius><length>0.06</length></cylinder></geometry><material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0.1 0.1 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Target 3: 4cm Diameter Green Sphere -->
    <model name="target_green_sphere">
      <static>false</static>
      <pose>0 -2 0.32 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
        </inertial>
        <collision name="collision"><geometry><sphere><radius>0.02</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.02</radius></sphere></geometry><material><ambient>0.1 0.9 0.1 1</ambient><diffuse>0.1 0.9 0.1 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>